# Font configuration
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 16

# Window settings
window-padding-x = 14
window-padding-y = 14
window-height = 24
window-width = 80 
window-decoration = server
background-opacity = 0.85

# Terminal settings
term = xterm-256color

# Keybindings
keybind = f11=toggle_fullscreen

confirm-close-surface = false


# Themes
theme = tokyonight
